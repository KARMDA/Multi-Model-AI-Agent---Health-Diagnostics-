# ============================================================
# Multi-Model AI Agent — Health Diagnostics v2.0
# Copy this file to .env and fill in your values
# ============================================================

# ── Groq LLM (REQUIRED) ───────────────────────────────────
# Sign up at: https://console.groq.com/keys
# Free tier: 30 req/min, 14,400 req/day
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── OCR.space API (RECOMMENDED) ───────────────────────────
# Get free key at: https://ocr.space/ocrapi/freekey
# Free tier: 500 requests/day, no credit card needed
OCR_SPACE_API_KEY=your_ocr_space_key_here

# ── Tesseract (OPTIONAL for local) ────────────────────────
# Auto-detected on Linux/Mac. Set path only if needed.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Supabase (REQUIRED for persistence) ───────────────────
# Create project at: https://supabase.com/dashboard
# Find URL and anon key in: Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ── Application Settings ──────────────────────────────────
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
